<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import nz.ac.auckland.se206.ball.BouncingBallPane?>

<VBox fx:id="backgroundPane" alignment="TOP_CENTER" prefHeight="700.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.WordSearchController">
   <children>
      <Label alignment="CENTER" layoutX="124.0" layoutY="14.0" prefHeight="23.0" prefWidth="355.0" text="Word Hunter" textAlignment="CENTER">
         <font>
            <Font size="36.0" />
         </font>
      </Label>
      <BouncingBallPane prefHeight="109.0" prefWidth="461.0" />
      <TextField fx:id="wordsTextfield" prefHeight="43.0" prefWidth="380.0" promptText="Write some words here..." text="Riddle Contract Second" />
      <ProgressBar fx:id="progressBar" prefHeight="26.0" prefWidth="459.0" progress="0.0" />
      <Button fx:id="searchForDefinitionsButton" mnemonicParsing="false" onAction="#searchWords" text="Search for definitions!" />
      <ScrollPane hbarPolicy="NEVER">
         <content>
            <Accordion fx:id="resultsAccordion" />
         </content>
      </ScrollPane>

   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
